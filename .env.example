# Copy to .env (gitignored) and fill in. The backend and the Streamlit app load it at start-up.

# Live Claude for triage, case verdicts, officer briefs, scorecard text and citizen answers.
# Leave empty to run offline: cached answers (data/cache/ai_cache.json) and template fallbacks.
ANTHROPIC_API_KEY=

# Optional local model instead of Claude while developing (answers are cached and labelled "ollama").
# NAGARLENS_LLM=ollama
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=hf.co/Jackrong/DeepSeek-V4-Pro-Qwen3.5-9B-MTP-GGUF:Q4_K_M

# Frontend: where the Next.js app finds the API.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: only used by `demo/walkthrough.py --tts elevenlabs` for the demo narration.
ELEVENLABS_API_KEY=
